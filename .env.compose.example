# Copy to `.env` in repo root before `docker compose up -d`

POSTGRES_DB=ozon_admin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<replace-with-strong-db-password>
POSTGRES_PORT=5432

# For docker-compose internal network, host should be `postgres`
DATABASE_URL=postgresql://postgres:<replace-with-strong-db-password>@postgres:5432/ozon_admin?schema=public

API_PORT=3001
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
