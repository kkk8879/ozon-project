NODE_ENV=production
HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=https://your-admin-domain.com
TRUST_PROXY=true

DATABASE_URL="postgresql://<db_user>:<db_password>@<db_host>:5432/<db_name>?schema=public"

ORDER_AUTO_SYNC_ENABLED=true
ORDER_AUTO_SYNC_INTERVAL_MINUTES=2
ORDER_AUTO_SYNC_STARTUP_DELAY_SECONDS=30
ORDER_AUTO_SYNC_DAYS=30
ORDER_AUTO_SYNC_LIMIT=1000
ORDER_AUTO_SYNC_MAX_PAGES=10
ORDER_MANUAL_FULL_SYNC_DAYS=365
ORDER_MANUAL_FULL_SYNC_MAX_PAGES=50

OZON_SYNC_MODE=auto
OZON_API_BASE_URL=https://api-seller.ozon.ru
OZON_SYNC_PAGE_LIMIT=100
OZON_SYNC_MAX_PAGES=10
OZON_SYNC_DAYS=30
OZON_SYNC_INCLUDE_FBS=true
OZON_SYNC_INCLUDE_FBO=true
OZON_SYNC_FBS_PATH=/v3/posting/fbs/list
OZON_SYNC_FBO_PATH=/v2/posting/fbo/list

ORDER_WEBHOOK_ENABLED=true
ORDER_WEBHOOK_SECRET=<replace-with-strong-random-secret>
